{
    "name": "gestion/clientes-pedidos-service",
    "description": "Microservicio de Clientes y Pedidos - PHP 8",
    "type": "project",
    "require": {
        "php": "^8.1",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.7",
        "php-di/slim-bridge": "^3.4",
        "firebase/php-jwt": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "respect/validation": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox"
    }
}
